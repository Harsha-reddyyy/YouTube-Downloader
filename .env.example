# ==============================================================================
# Media Downloader - Environment Configuration
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# File Storage & Retention
# Temporary directory where intermediate chunks/streams are downloaded and processed
STORAGE_TEMP_DIR=./storage/temp
# Storage directory where completed ready-to-download files are kept
STORAGE_DIR=./storage/downloads
# Time-To-Live (in seconds) before completed files and job metadata are automatically deleted (default: 1800s / 30m)
FILE_TTL_SECONDS=1800
# Background interval (in seconds) to clean expired files from disk (default: 300s / 5m)
CLEANUP_INTERVAL_SECONDS=300

# Concurrency & Resource Limits
# Maximum concurrent transcoding/processing tasks running simultaneously
MAX_CONCURRENT_JOBS=3
# Maximum source media duration allowed in seconds (e.g. 7200 = 2 hours)
MAX_VIDEO_DURATION_SECONDS=7200
# Maximum file size allowed for processing in bytes (e.g. 1073741824 = 1GB)
MAX_FILE_SIZE_BYTES=1073741824

# External Binary Paths (leave blank to auto-detect from PATH)
# On macOS with Homebrew, FFmpeg is usually /opt/homebrew/bin/ffmpeg
# On Linux / Debian / Alpine, usually /usr/bin/ffmpeg
FFMPEG_PATH=
# Python or yt-dlp binary path. Leave blank to auto-detect "yt-dlp" or "python3 -m yt_dlp"
YTDLP_PATH=

# Security & Rate Limiting
# Maximum requests allowed per IP address within the rate limit window
RATE_LIMIT_MAX_REQUESTS=40
# Rate limit window in seconds
RATE_LIMIT_WINDOW_SECONDS=60
# Secret key used for signing temporary download tokens (generate a secure random 32+ char string in production)
TOKEN_SECRET=dev_insecure_secret_key_change_in_production_32chars
